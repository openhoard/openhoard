{
  "name": "@openhoard/ai-enrich",
  "version": "0.0.0",
  "private": true,
  "description": "The enrichment steps that send a version's content out of the core: text extraction, summaries and model tags, embeddings.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@openhoard/ai-models": "workspace:^",
    "@openhoard/core-catalog": "workspace:^",
    "@openhoard/core-db": "workspace:^",
    "@openhoard/core-jobs": "workspace:^",
    "@openhoard/core-summarize": "workspace:^",
    "@openhoard/enricher-extract": "workspace:^"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*",
    "@openhoard/core-identity": "workspace:*",
    "@openhoard/core-policy": "workspace:*",
    "@openhoard/testkit": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "license": "Apache-2.0"
}
