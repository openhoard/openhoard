{
  "name": "@openhoard/server",
  "version": "0.0.0",
  "private": true,
  "description": "OpenHoard gateway: HTTP API and (soon) the MCP server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts --data-dir ../../.openhoard",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openhoard/ai-enrich": "workspace:^",
    "@openhoard/ai-models": "workspace:^",
    "@openhoard/connector-fs": "workspace:^",
    "@openhoard/connector-sharepoint": "workspace:^",
    "@openhoard/core-audit": "workspace:^",
    "@openhoard/core-catalog": "workspace:^",
    "@openhoard/core-db": "workspace:^",
    "@openhoard/core-identity": "workspace:^",
    "@openhoard/core-jobs": "workspace:^",
    "@openhoard/core-policy": "workspace:^",
    "@openhoard/core-storage": "workspace:^",
    "@openhoard/sdk": "workspace:^",
    "@openhoard/web": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "imapflow": "^2.5.2",
    "openid-client": "^6.8.8",
    "pino": "^10.4.0",
    "postal-mime": "^4.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*",
    "@openhoard/testkit": "workspace:*",
    "ajv": "8.20.0"
  },
  "license": "Apache-2.0"
}
