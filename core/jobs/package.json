{
  "name": "@openhoard/core-jobs",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs on pg-boss: the enrichment pipeline and scheduled maintenance.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@openhoard/core-catalog": "workspace:^",
    "@openhoard/core-db": "workspace:^",
    "@openhoard/core-identity": "workspace:^",
    "drizzle-orm": "^0.45.3",
    "pg-boss": "^12.34.0"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*",
    "@openhoard/core-policy": "workspace:*"
  },
  "license": "Apache-2.0"
}
