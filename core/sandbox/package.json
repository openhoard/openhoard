{
  "name": "@openhoard/core-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Plugin manifests and capability enforcement.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@openhoard/schemas": "workspace:^"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*"
  },
  "license": "Apache-2.0"
}
