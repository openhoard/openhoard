{
  "name": "@openhoard/core-storage",
  "version": "0.0.0",
  "private": true,
  "description": "Blob storage: content-addressed, tenant-scoped blobs on local disk, S3 or Azure Blob through Apache OpenDAL.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@openhoard/core-db": "workspace:^",
    "drizzle-orm": "^0.45.4",
    "opendal": "^0.49.12"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*"
  },
  "license": "Apache-2.0"
}
