{
  "name": "openhoard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@openhoard/server",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage",
    "changeset": "changeset",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@openhoard/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.1"
  }
}
