{
  "name": "@openhoard/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Offline test kit: deterministic fake tenants, a fake Microsoft Graph, a dev OIDC provider, attack corpora and leak/benchmark harnesses.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist coverage",
    "injection:report": "tsx scripts/injection-report.ts",
    "injection:write": "tsx scripts/write-corpus.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openhoard/core-audit": "workspace:^",
    "@openhoard/core-catalog": "workspace:^",
    "@openhoard/core-summarize": "workspace:^",
    "@openhoard/sdk": "workspace:^",
    "hono": "^4.8.0",
    "jose": "^6.2.12",
    "oidc-provider": "^9.12.2"
  },
  "devDependencies": {
    "@openhoard/config": "workspace:*",
    "@openhoard/core-db": "workspace:^",
    "@openhoard/core-identity": "workspace:^",
    "@openhoard/core-policy": "workspace:^",
    "@types/oidc-provider": "^9.12.1"
  },
  "license": "Apache-2.0"
}
